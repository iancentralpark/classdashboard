+function normalizeMonitorDate(raw) {
+  const today = todayStr();
+  if (raw == null || raw === '') return today;
+  const s = String(raw).trim().slice(0, 10);
+  if (!/^\d{4}-\d{2}-\d{2}$/.test(s)) return today;
+  // Reject far-future dates; allow history up to ~1 year.
+  if (s > today) return today;
+  const oldest = new Date();
+  oldest.setFullYear(oldest.getFullYear() - 1);
+  const oldestStr = oldest.toLocaleDateString('en-CA', { timeZone: 'Asia/Seoul' });
+  if (s < oldestStr) return oldestStr;
+  return s;
+}
+
+function activityLookbackDaysForDate(questDate) {
+  const today = todayStr();
+  const gap = daysBetween(questDate, today);
+  if (gap == null || gap < 0) return 2;
+  return Math.max(2, Math.min(60, gap + 2));
+}
