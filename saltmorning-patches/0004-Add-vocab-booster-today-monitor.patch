+                timeZone: 'Asia/Seoul',
+                month: 'short',
+                day: 'numeric',
+                hour: '2-digit',
+                minute: '2-digit',
+                hour12: false
+            });
+        } catch (e) {
+            return '—';
+        }
+    }
+
+    function formatVocabMonitorDelta(n) {
+        var v = Number(n) || 0;
+        if (!v) return '<span class="vocab-monitor-delta">0</span>';
+        var cls = v > 0 ? 'pos' : 'neg';
+        return '<span class="vocab-monitor-delta ' + cls + '">' + (v > 0 ? '+' : '') + v + '</span>';
+    }
