new file mode 100644
index 0000000..3595a35
--- /dev/null
+++ b/server/scripts/test-vocab-promotion.js
@@ -0,0 +1,113 @@
+#!/usr/bin/env node
+/**
+ * Unit checks for vocab promotion ladder + 3-day decay grace.
+ * Run: node server/scripts/test-vocab-promotion.js
+ */
+const assert = require('assert');
+const {
+  scoreDeltaForAttempt,
+  applyAttemptToLadder,
+  applyInactivityDecay,
+  DECAY_GRACE_DAYS,
+  DEMOTE_REENTRY_SCORE
+} = require('../src/vocabPromotionService');
+
+function check(name, fn) {
+  try {
+    fn();
+    console.log('ok  ', name);
+  } catch (e) {
+    console.error('FAIL', name, e.message);
+    process.exitCode = 1;
+  }
+}
+
+check('7/10 yields +6 (must not demote by itself)', function () {
+  assert.strictEqual(scoreDeltaForAttempt(7, 10), 6);
+  const r = applyAttemptToLadder(
+    { grade_level: 7, promotion_score: 100, shield_count: 0 },
+    7,
+    10
+  );
+  assert.strictEqual(r.scoreDelta, 6);
+  assert.strictEqual(r.promotionScore, 106);
+  assert.strictEqual(r.demoted, null);
+  assert.strictEqual(r.gradeLevel, 7);
+});
+
+check('0/10 from low score demotes to re-entry 390', function () {
+  const r = applyAttemptToLadder(
+    { grade_level: 7, promotion_score: 10, shield_count: 0 },
+    0,
+    10
+  );
+  assert.strictEqual(r.scoreDelta, -15);
+  assert.strictEqual(r.demoted, 'down');
+  assert.strictEqual(r.gradeLevel, 6);
+  assert.strictEqual(r.promotionScore, DEMOTE_REENTRY_SCORE);
+});
+
+check('idle day 1–3 within grace: no decay, no demote', function () {
+  for (let idle = 0; idle <= DECAY_GRACE_DAYS; idle++) {
+    const last = '2026-07-28';
+    // today = last + idle days
+    const d = new Date('2026-07-28T12:00:00');
+    d.setDate(d.getDate() + idle);
+    const today =
+      d.getFullYear() +
+      '-' +
+      String(d.getMonth() + 1).padStart(2, '0') +
+      '-' +
+      String(d.getDate()).padStart(2, '0');
+    const r = applyInactivityDecay(
+      {
+        grade_level: 4,
+        tier_name: 'Silver',
+        promotion_score: 50,
+        shield_count: 0,
+        last_completed_date: last
+      },
+      today
+    );
+    assert.strictEqual(r.withinGrace, true, 'idle=' + idle);
+    assert.strictEqual(r.changed, false, 'idle=' + idle);
+    assert.strictEqual(r.demoted, null, 'idle=' + idle);
+    assert.strictEqual(r.promotionScore, 50, 'idle=' + idle);
+  }
+});
+
+check('Arthur-style: 1 idle day must not demote', function () {
+  const r = applyInactivityDecay(
+    {
+      grade_level: 4,
+      tier_name: 'Silver',
+      promotion_score: 5,
+      shield_count: 0,
+      last_completed_date: '2026-07-31'
+    },
+    '2026-08-01'
+  );
+  assert.strictEqual(r.idleDays, 1);
+  assert.strictEqual(r.withinGrace, true);
+  assert.strictEqual(r.changed, false);
+  assert.strictEqual(r.demoted, null);
+});
+
+check('day 4 idle can decay points', function () {
+  const r = applyInactivityDecay(
+    {
+      grade_level: 4,
+      tier_name: 'Silver',
+      promotion_score: 100,
+      shield_count: 0,
+      last_completed_date: '2026-07-28'
+    },
+    '2026-08-01' // 4 days later
+  );
+  assert.strictEqual(r.idleDays, 4);
+  assert.strictEqual(r.withinGrace, false);
+  assert.ok(r.scoreDelta < 0);
+  assert.strictEqual(r.promotionScore, 100 - 15); // 1 penalized day
+});
+
+if (!process.exitCode) console.log('\nAll vocab promotion checks passed.');
