+      const started = m.startedAt || ev.at;
+      if (started && (!row.studyStartedAt || started < row.studyStartedAt)) row.studyStartedAt = started;
+      if (m.isRetry) row.retried = true;
+      return;
+    }
+
+    if (kind === 'vocab_set') {
+      row.setsAttempted += 1;
+      if (m.passed) row.setsPassed += 1;
+      const correct = Math.max(0, Number(m.correctCount) || 0);
+      const total = Math.max(0, Number(m.totalCount) || 0);
+      const wrong =
+        m.wrongCount != null ? Math.max(0, Number(m.wrongCount) || 0) : Math.max(0, total - correct);
+      row.correctTotal += correct;
+      row.wrongTotal += wrong;
+      if (m.isRetry) row.retried = true;
+      const dur = Math.max(0, Number(m.durationMs) || 0);
