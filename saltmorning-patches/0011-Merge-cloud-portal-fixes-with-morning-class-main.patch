+    function vocabActivityKindClass(kind) {
+        var k = String(kind || '');
+        if (k.indexOf('promote') !== -1) return 'is-promote';
+        if (k.indexOf('demote') !== -1) return 'is-demote';
+        if (k.indexOf('placement') !== -1) return 'is-place';
+        if (k.indexOf('vocab_set') !== -1 || k.indexOf('set') !== -1) return 'is-set';
+        return '';
+    }
+
+    function vocabActivityKindLabel(kind) {
+        var k = String(kind || 'event');
+        if (k === 'vocab_promote') return 'Promote';
+        if (k === 'vocab_demote') return 'Demote';
+        if (k === 'vocab_set') return 'Set';
+        if (k === 'vocab_placement') return 'Placement';
+        return k.replace(/^vocab_/, '').replace(/_/g, ' ');
+    }
+
+    function formatVocabActivityTime(iso) {
+        if (!iso) return '';
+        try {
+            var d = new Date(iso);
+            if (isNaN(d.getTime())) return String(iso).slice(0, 16);
+            return d.toLocaleString('en-CA', {
+                timeZone: 'Asia/Seoul',
+                month: 'short',
+                day: 'numeric',
+                hour: '2-digit',
+                minute: '2-digit',
+                hour12: false
+            });
+        } catch (e) {
+            return String(iso).slice(0, 16);
+        }
+    }
+
+    function openVocabActivityModal() {
+        if (!selectedClass) {
+            appAlert('Please select a class first.');
+            return;
+        }
+        document.getElementById('vocabActivityClassName').textContent = selectedClass.name;
+        var modalEl = document.getElementById('vocabActivityModal');
+        elevateAppDialogModal(modalEl);
+        bootstrap.Modal.getOrCreateInstance(modalEl).show();
+        refreshVocabActivityFeed();
+    }
+
+    function refreshVocabActivityFeed() {
+        if (!selectedClass) return;
+        var loading = document.getElementById('vocabActivityLoading');
+        var empty = document.getElementById('vocabActivityEmpty');
+        var list = document.getElementById('vocabActivityList');
+        var meta = document.getElementById('vocabActivityMeta');
+        var daysEl = document.getElementById('vocabActivityDays');
+        var days = Math.max(1, Number(daysEl && daysEl.value) || 7);
+        loading.classList.remove('d-none');
+        empty.classList.add('d-none');
+        list.classList.add('d-none');
+        list.innerHTML = '';
+        if (meta) meta.textContent = '';
+        var url = '/api/teacher/activity?classId=' + encodeURIComponent(selectedClass.id) +
+            '&days=' + encodeURIComponent(String(days));
+        nodeFetch(url)
+            .then(function(res) {
+                loading.classList.add('d-none');
+                var events = (res && res.events) || [];
+                if (meta) {
+                    meta.textContent = events.length
+                        ? events.length + ' event' + (events.length === 1 ? '' : 's')
+                        : '';
+                }
+                if (!events.length) {
+                    empty.classList.remove('d-none');
+                    return;
+                }
+                list.innerHTML = events.map(function(ev) {
+                    var kind = String(ev.kind || '');
+                    var name = ev.studentName || ev.studentId || 'Student';
+                    var title = ev.title || vocabActivityKindLabel(kind);
+                    var detail = ev.detail || '';
+                    return '<div class="vocab-activity-item">' +
+                        '<div class="vocab-activity-item-top">' +
+                        '<span class="vocab-activity-kind ' + vocabActivityKindClass(kind) + '">' +
+                        escapeHtml(vocabActivityKindLabel(kind)) + '</span>' +
+                        '<span class="vocab-activity-title">' + escapeHtml(name) +
+                        (title ? ' · ' + escapeHtml(title) : '') + '</span>' +
+                        '<span class="vocab-activity-time">' + escapeHtml(formatVocabActivityTime(ev.at)) + '</span>' +
+                        '</div>' +
+                        (detail ? '<div class="vocab-activity-detail">' + escapeHtml(detail) + '</div>' : '') +
+                        '</div>';
+                }).join('');
+                list.classList.remove('d-none');
+            })
+            .catch(function(err) {
+                loading.classList.add('d-none');
+                empty.classList.remove('d-none');
+                empty.textContent = err.message || 'Could not load activity.';
+            });
+    }
+
+    function initVocabActivityModal() {
+        var refreshBtn = document.getElementById('vocabActivityRefreshBtn');
+        if (refreshBtn) refreshBtn.addEventListener('click', refreshVocabActivityFeed);
+        var daysEl = document.getElementById('vocabActivityDays');
+        if (daysEl) daysEl.addEventListener('change', refreshVocabActivityFeed);
+    }
