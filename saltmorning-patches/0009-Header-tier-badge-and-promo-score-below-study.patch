+  function renderWelcomeTierBadges(tierName) {
+    var badge = tierName ? (TIER_BADGES[tierName] || TIER_BADGES.Rookie) : null;
+    ['welcomeTierBadge', 'welcomeTierBadgeMobile'].forEach(function (id) {
+      var el = $(id);
+      if (!el) return;
+      var mark = el.querySelector('.welcome-tier-badge-mark');
+      var nameEl = el.querySelector('.welcome-tier-badge-name');
+      if (!badge || !tierName) {
+        el.className = 'welcome-tier-badge';
+        el.classList.remove('is-visible');
+        el.setAttribute('hidden', '');
+        el.setAttribute('aria-hidden', 'true');
+        if (mark) mark.innerHTML = '';
+        if (nameEl) nameEl.textContent = '';
+        return;
+      }
+      el.className = 'welcome-tier-badge is-visible ' + badge.className;
+      el.removeAttribute('hidden');
+      el.setAttribute('aria-hidden', 'false');
+      el.setAttribute('aria-label', 'Vocab Booster tier: ' + tierName);
+      el.setAttribute('title', tierName + ' · Open Vocab Booster');
+      if (mark) mark.innerHTML = '<i class="fa-solid ' + badge.icon + '"></i>';
+      if (nameEl) nameEl.textContent = tierName;
+    });
+  }
+
+  function openVocabBoosterFromHeader() {
+    try {
+      if (typeof window.setMobilePanel === 'function') {
+        window.setMobilePanel('vocab');
+      } else {
+        var navBtn = document.querySelector('.mobile-nav-btn[data-mobile-tab="vocab"]');
+        if (navBtn) navBtn.click();
+        else if (document.body) document.body.setAttribute('data-mobile-tab', 'vocab');
+      }
+    } catch (e) { /* ignore */ }
+    var shell = $('vocabShell');
+    if (shell && typeof shell.scrollIntoView === 'function') {
+      requestAnimationFrame(function () {
+        shell.scrollIntoView({ behavior: 'smooth', block: 'start' });
+      });
+    }
+    if (state.placementDone) {
+      setTimeout(function () { setTierLadderOpen(true); }, 180);
+    }
+  }
+
+  function wireWelcomeTierBadges() {
+    ['welcomeTierBadge', 'welcomeTierBadgeMobile'].forEach(function (id) {
+      var el = $(id);
+      if (!el || el.dataset.wired === '1') return;
+      el.dataset.wired = '1';
+      el.addEventListener('click', function (e) {
+        e.preventDefault();
+        openVocabBoosterFromHeader();
+      });
+    });
+  }
+
