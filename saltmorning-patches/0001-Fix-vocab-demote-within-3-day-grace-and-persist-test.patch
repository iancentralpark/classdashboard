diff --git a/server/src/vocabPromotionService.js b/server/src/vocabPromotionService.js
new file mode 100644
index 0000000..e245661
--- /dev/null
+++ b/server/src/vocabPromotionService.js
@@ -0,0 +1,229 @@
+/**
+ * Vocab Booster promotion ladder (0–400) + inactivity decay.
+ *
+ * Rules:
+ *  - Every daily-test submit (pass or fail) adjusts score:
+ *      delta = (correctCount - totalCount / 2) * 3
+ *    (10-question set: 70% → +6, 100% → +15, 0% → −15)
+ *  - Score ≥ 400 → promote one grade, score resets to 0, shield = 20
+ *  - Score would go ≤ 0 with no shield → demote one grade, re-entry at 390
+ *  - Shield blocks demotion; each submit burns 10 shield while held
+ *  - Inactivity decay: NO score loss for the first DECAY_GRACE_DAYS (3) Seoul
+ *    calendar days without a completed set. Decay only starts on day 4+.
+ *  - Decay / demote-from-idle must NOT run inside the grace window (the bug
+ *    that demoted Arthur after 1 idle day).
+ */
+const { tierForGrade, GRADE_MIN, GRADE_MAX } = require('./vocabPlacementService');
+
+const SEOUL_TZ = 'Asia/Seoul';
+const PROMOTION_SCORE_MAX = 400;
+const DEMOTE_REENTRY_SCORE = 390;
+const SHIELD_ON_PROMOTE = 20;
+const SHIELD_BURN_PER_SUBMIT = 10;
+/** Full Seoul calendar days of inactivity with zero score penalty. */
+const DECAY_GRACE_DAYS = 3;
+/** Points lost per idle day after the grace window (applied on read/login). */
+const DECAY_POINTS_PER_IDLE_DAY = 15;
+
+function formatSeoulDate(value) {
+  if (value == null || value === '') return '';
+  if (typeof value === 'string' && /^\d{4}-\d{2}-\d{2}$/.test(value.trim())) {
+    return value.trim();
+  }
+  const d = value instanceof Date ? value : new Date(value);
+  if (isNaN(d.getTime())) return String(value).slice(0, 10);
+  return d.toLocaleDateString('en-CA', { timeZone: SEOUL_TZ });
+}
+
+function clampScore(n) {
+  const x = Math.round(Number(n) || 0);
+  return Math.max(0, Math.min(PROMOTION_SCORE_MAX, x));
+}
+
+function clampGrade(n) {
+  return Math.max(GRADE_MIN, Math.min(GRADE_MAX, Math.round(Number(n) || GRADE_MIN)));
+}
+
+function todaySeoul() {
+  return formatSeoulDate(new Date());
+}
+
+function daysBetweenSeoul(a, b) {
+  if (!a || !b) return null;
+  const MS = 24 * 60 * 60 * 1000;
+  const da = new Date(String(a).slice(0, 10) + 'T12:00:00');
+  const db = new Date(String(b).slice(0, 10) + 'T12:00:00');
+  if (isNaN(da.getTime()) || isNaN(db.getTime())) return null;
+  return Math.round((db - da) / MS);
+}
+
+/**
+ * Score delta for one daily-test submit.
+ * Positive when above 50% accuracy — a 7/10 (+6) must never demote by itself.
+ */
+function scoreDeltaForAttempt(correctCount, totalCount) {
+  const total = Math.max(1, Number(totalCount) || 0);
+  const correct = Math.max(0, Math.min(total, Number(correctCount) || 0));
+  return Math.round((correct - total / 2) * 3);
+}
+
+function idleDaysSince(lastCompletedDate, today) {
+  const day = today || todaySeoul();
+  if (!lastCompletedDate) {
+    // Never completed a set after placement — treat placement day via caller.
+    return null;
+  }
+  const gap = daysBetweenSeoul(String(lastCompletedDate).slice(0, 10), day);
+  if (gap == null) return null;
+  return Math.max(0, gap);
+}
+
+/**
+ * Apply promotion-score change from a test attempt.
+ * @returns {{ gradeLevel, tierName, promotionScore, shieldCount, scoreDelta, promoted, demoted, beforeScore, afterScore }}
+ */
+function applyAttemptToLadder(state, correctCount, totalCount) {
+  const beforeScore = clampScore(state && state.promotion_score);
+  let grade = clampGrade(state && state.grade_level);
+  let shield = Math.max(0, Math.round(Number(state && state.shield_count) || 0));
+  const delta = scoreDeltaForAttempt(correctCount, totalCount);
+  let score = beforeScore + delta;
+  let promoted = null;
+  let demoted = null;
+
+  if (shield > 0) {
+    shield = Math.max(0, shield - SHIELD_BURN_PER_SUBMIT);
+  }
+
+  if (score >= PROMOTION_SCORE_MAX && grade < GRADE_MAX) {
+    grade += 1;
+    score = 0;
+    shield = SHIELD_ON_PROMOTE;
+    promoted = 'up';
+  } else if (score <= 0) {
+    if (shield > 0) {
+      // Shield absorbs the demotion; park at 0 until next climb.
+      score = 0;
+    } else if (grade > GRADE_MIN) {
+      grade -= 1;
+      score = DEMOTE_REENTRY_SCORE;
+      demoted = 'down';
+    } else {
+      score = 0;
+    }
+  } else {
+    score = clampScore(score);
+  }
+
+  const tier = tierForGrade(grade);
+  return {
+    gradeLevel: grade,
+    tierName: tier.name,
+    promotionScore: clampScore(score),
+    shieldCount: shield,
+    scoreDelta: delta,
+    promoted: promoted,
+    demoted: demoted,
+    beforeScore: beforeScore,
+    afterScore: clampScore(score)
+  };
+}
+
+/**
+ * Inactivity decay. Returns null when grace still covers the student
+ * (idleDays <= DECAY_GRACE_DAYS) — no score change, no demote.
+ *
+ * After grace, each extra idle day beyond grace subtracts DECAY_POINTS_PER_IDLE_DAY.
+ * Demote only if score hits ≤0 with no shield — same re-entry rule as attempts.
+ */
+function applyInactivityDecay(state, today) {
+  const day = today || todaySeoul();
+  const last = state && (state.last_completed_date || state.lastCompletedDate);
+  let idle = idleDaysSince(last, day);
+
+  // If they never completed a set, fall back to placement date (Seoul day).
+  if (idle == null && state && state.placement_at) {
+    const placedDay = formatSeoulDate(state.placement_at);
+    idle = idleDaysSince(placedDay, day);
+  }
+  if (idle == null) idle = 0;
+
+  const withinGrace = idle <= DECAY_GRACE_DAYS;
+  const decayWarning = idle > DECAY_GRACE_DAYS;
+
+  if (withinGrace || idle <= 0) {
+    return {
+      changed: false,
+      withinGrace: true,
+      idleDays: idle,
+      decayWarning: false,
+      gradeLevel: clampGrade(state && state.grade_level),
+      tierName: (state && state.tier_name) || tierForGrade(clampGrade(state && state.grade_level)).name,
+      promotionScore: clampScore(state && state.promotion_score),
+      shieldCount: Math.max(0, Math.round(Number(state && state.shield_count) || 0)),
+      demoted: null,
+      scoreDelta: 0
+    };
+  }
+
+  const penalizedDays = idle - DECAY_GRACE_DAYS;
+  const loss = penalizedDays * DECAY_POINTS_PER_IDLE_DAY;
+  const beforeScore = clampScore(state && state.promotion_score);
+  let score = beforeScore - loss;
+  let grade = clampGrade(state && state.grade_level);
+  let shield = Math.max(0, Math.round(Number(state && state.shield_count) || 0));
+  let demoted = null;
+  let scoreDelta = -loss;
+
+  if (score <= 0) {
+    if (shield > 0) {
+      score = 0;
+      // Burn one shield charge for the decay hit instead of demoting.
+      shield = Math.max(0, shield - SHIELD_BURN_PER_SUBMIT);
+    } else if (grade > GRADE_MIN) {
+      grade -= 1;
+      score = DEMOTE_REENTRY_SCORE;
+      demoted = 'down';
+    } else {
+      score = 0;
+    }
+  }
+
+  const tier = tierForGrade(grade);
+  const changed =
+    demoted != null ||
+    clampScore(score) !== beforeScore ||
+    grade !== clampGrade(state && state.grade_level) ||
+    shield !== Math.max(0, Math.round(Number(state && state.shield_count) || 0));
+
+  return {
+    changed: changed,
+    withinGrace: false,
+    idleDays: idle,
+    decayWarning: decayWarning,
+    gradeLevel: grade,
+    tierName: tier.name,
+    promotionScore: clampScore(score),
+    shieldCount: shield,
+    demoted: demoted,
+    scoreDelta: scoreDelta,
+    beforeScore: beforeScore,
+    afterScore: clampScore(score)
+  };
+}
+
+module.exports = {
+  PROMOTION_SCORE_MAX,
+  DEMOTE_REENTRY_SCORE,
+  SHIELD_ON_PROMOTE,
+  SHIELD_BURN_PER_SUBMIT,
+  DECAY_GRACE_DAYS,
+  DECAY_POINTS_PER_IDLE_DAY,
+  clampScore,
+  todaySeoul,
+  daysBetweenSeoul,
+  scoreDeltaForAttempt,
+  idleDaysSince,
+  applyAttemptToLadder,
+  applyInactivityDecay
+};
