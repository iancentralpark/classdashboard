+-- Vocab Booster promotion ladder (0-400) + attempt history + activity feed.
+-- Safe to re-run.
+
+ALTER TABLE vocab_student_state
+  ADD COLUMN IF NOT EXISTS promotion_score INTEGER NOT NULL DEFAULT 0
+    CHECK (promotion_score >= 0 AND promotion_score <= 400),
+  ADD COLUMN IF NOT EXISTS shield_count INTEGER NOT NULL DEFAULT 0
+    CHECK (shield_count >= 0),
+  ADD COLUMN IF NOT EXISTS last_active_at TIMESTAMPTZ;
