new file mode 100644
index 0000000..df4a254
--- /dev/null
+++ b/server/src/vocabActivityService.js
@@ -0,0 +1,75 @@
+/**
+ * Append-only Vocab / portal activity events for the teacher Activity feed.
+ */
+const { isSupabaseEnabled, getSupabase } = require('./supabaseClient');
+
+function newEventId(kind) {
+  return (
+    'ACT_' +
+    String(kind || 'event').slice(0, 12) +
+    '_' +
+    Date.now().toString(36) +
+    '_' +
+    Math.random().toString(36).slice(2, 8)
+  );
+}
+
+async function logVocabActivity(evt) {
+  if (!isSupabaseEnabled()) return null;
+  const db = getSupabase();
+  const row = {
+    id: evt.id || newEventId(evt.kind),
+    at: evt.at || new Date().toISOString(),
+    class_id: evt.classId ? String(evt.classId) : null,
+    student_id: String(evt.studentId || ''),
+    student_name: evt.studentName ? String(evt.studentName) : null,
+    kind: String(evt.kind || 'event'),
+    title: String(evt.title || ''),
+    detail: String(evt.detail || ''),
+    meta: evt.meta && typeof evt.meta === 'object' ? evt.meta : {}
+  };
+  if (!row.student_id) return null;
+  const { error } = await db.from('vocab_activity_events').insert(row);
+  if (error) {
+    console.warn('logVocabActivity', error.message || error);
+    return null;
+  }
+  return row;
+}
+
+async function listActivityEvents(opts) {
+  opts = opts || {};
+  if (!isSupabaseEnabled()) return { since: null, count: 0, events: [] };
+  const db = getSupabase();
+  const days = Math.max(1, Math.min(60, Number(opts.days) || 7));
+  const since = new Date(Date.now() - days * 24 * 60 * 60 * 1000).toISOString();
+  let q = db
+    .from('vocab_activity_events')
+    .select('*')
+    .gte('at', since)
+    .order('at', { ascending: false })
+    .limit(Math.max(1, Math.min(500, Number(opts.limit) || 200)));
+  if (opts.classId) q = q.eq('class_id', String(opts.classId));
+  const { data, error } = await q;
+  if (error) throw new Error(error.message);
+  const events = (data || []).map(function (r) {
+    return {
+      id: r.id,
+      at: r.at,
+      classId: r.class_id,
+      studentId: r.student_id,
+      studentName: r.student_name,
+      kind: r.kind,
+      title: r.title,
+      detail: r.detail,
+      meta: r.meta || {}
+    };
+  });
+  return { since: since, count: events.length, events: events };
+}
+
+module.exports = {
+  logVocabActivity,
+  listActivityEvents,
+  newEventId
+};
