From 4cb907a5fe9f0dbfb325d1afa006646956722be8 Mon Sep 17 00:00:00 2001
From: Cursor Agent <cursoragent@cursor.com>
Date: Sat, 1 Aug 2026 09:09:57 +0000
Subject: [PATCH] Show teacher student roster on non-class days on mobile too.

Keep the off-day warning and makeup bar, but still load work panels
so phone layout matches desktop/iPad instead of wiping the roster.
---
 Index.html                     | 13 +++++++++----
 server/public/Student.html     |  8 ++++----
 server/public/Teacher.html     | 15 ++++++++++-----
 server/public/sw.js            |  2 +-
 server/scripts/build-public.js |  2 +-
 server/src/routes.js           |  2 +-
 server/teacher-src/Index.html  | 13 +++++++++----
 7 files changed, 35 insertions(+), 20 deletions(-)

diff --git a/Index.html b/Index.html
index 8b57383..1e94b76 100644
--- a/Index.html
+++ b/Index.html
@@ -11872,23 +11872,28 @@
         const dayOfWeek = dateObj.getDay();
         const alertBox = document.getElementById('scheduleAlert');
 
+        // Off-day / holiday: keep the warning + makeup bar, but still show the
+        // student roster and work panels (desktop, iPad, and phone).
+        // Mobile used to re-hide via workPanelsBlocked; that gate is removed.
         if (holidayName) {
-            workPanelsBlocked = true;
+            workPanelsBlocked = false;
             alertBox.className = 'alert alert-danger w-100 mb-0 py-2 fw-bold text-center';
             alertBox.innerHTML = '<i class="fa-solid fa-calendar-xmark"></i> ' + escapeHtml(holidayName) +
                 ' · Public holiday (no class for any class)';
-            setWorkSectionsHidden(true);
             updateMakeupOffDayBar(true);
+            if (work) applyWorkPanels(work, dateInput);
+            else reloadWorkData(true);
             return;
         }
 
         if (!selectedClass.allowedDays.includes(dayOfWeek)) {
-            workPanelsBlocked = true;
+            workPanelsBlocked = false;
             alertBox.className = 'alert alert-danger w-100 mb-0 py-2 fw-bold text-center';
             alertBox.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i> ' +
                 dayNames[dayOfWeek] + ' is not a scheduled day for [' + escapeHtml(selectedClass.name) + '].';
-            setWorkSectionsHidden(true);
             updateMakeupOffDayBar(true);
+            if (work) applyWorkPanels(work, dateInput);
+            else reloadWorkData(true);
             return;
         }
 
